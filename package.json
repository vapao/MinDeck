{
  "name": "mindeck",
  "private": true,
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:server": "pnpm --filter @mindeck/server dev",
    "dev:web": "pnpm --filter @mindeck/web dev",
    "build": "pnpm --filter @mindeck/web build",
    "start": "pnpm --filter @mindeck/server start",
    "typecheck": "pnpm -r typecheck",
    "codex:schema": "pnpm --filter @mindeck/server codex:schema",
    "build:release": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "yaml": "2.8.2"
  }
}
